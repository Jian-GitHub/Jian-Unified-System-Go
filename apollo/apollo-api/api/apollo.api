syntax = "v1"

type GoogleSheetsReq {
	ClientId     string `json:"client_id"`
	ClientSecret string `json:"client_secret"`
	Token        string `json:"token"`
	Action       string `json:"action"`
	State        string `json:"state,optional"`
	Code         string `json:"code,optional"`
	Spreadsheet  string `json:"spreadsheet,optional"`
	Range        string `json:"range,optional"`
}

type GoogleSheetsResp {
	Url       string     `json:"url"`
	Bound     bool       `json:"bound"`
	Connected bool       `json:"connected"`
	Rows      [][]string `json:"rows"`
}

@server (
	prefix: /v1/sso
	group:  sso
)
service apollo-api {
	@handler GoogleSheets
	post /google-sheets (GoogleSheetsReq) returns (GoogleSheetsResp)
}

info (
	title:   "Apollo Account API"
	desc:    "邮箱账户注册与登录；先维护本协议，再执行 goapign"
	version: "v1"
)

type (
	BaseResponse {
		Code    int    `json:"code"`
		Message string `json:"message"`
	}
	RegReq {
		Email           string `json:"email"`
		Password        string `json:"password"`
		ConfirmPassword string `json:"confirm_password"`
		Language        string `json:"language"`
	}
	RegData {
		Token string `json:"token"`
	}
	RegResp {
		BaseResponse
		Data RegData `json:"data"`
	}
	LoginReq {
		Email           string `json:"email"`
		Password        string `json:"password"`
		CloudflareToken string `json:"cloudflareToken"`
	}
	UserName {
		GivenName  string `json:"givenName"`
		MiddleName string `json:"middleName"`
		FamilyName string `json:"familyName"`
	}
	Birthday {
		Year  int64 `json:"year"`
		Month int64 `json:"month"`
		Day   int64 `json:"day"`
	}
	LoginData {
		Token    string   `json:"token"`
		Id       string   `json:"id"`
		Name     UserName `json:"name"`
		Avatar   string   `json:"avatar"`
		Locale   string   `json:"locale"`
		Language string   `json:"language"`
		Birthday Birthday `json:"birthday"`
	}
	LoginResp {
		BaseResponse
		Data LoginData `json:"data"`
	}
)

@server (
	prefix: /v1/account
	group:  account
)
service apollo-api {
	@handler Reg
	post /registration (RegReq) returns (RegResp)

	@handler Login
	post /login (LoginReq) returns (LoginResp)
}

// 公开资料和安全查询只使用已认证主体，不接收客户端指定 user_id。
type (
	Empty  {}
	OkData {
		Ok bool `json:"ok"`
	}
	OkResp {
		BaseResponse
		Data OkData `json:"data"`
	}
	UserInfoData {
		Id                string `json:"id"`
		GivenName         string `json:"given_name"`
		MiddleName        string `json:"middle_name"`
		FamilyName        string `json:"family_name"`
		Avatar            string `json:"avatar"`
		BirthdayYear      int64  `json:"birthday_year"`
		BirthdayMonth     int64  `json:"birthday_month"`
		BirthdayDay       int64  `json:"birthday_day"`
		NotificationEmail string `json:"notification_email"`
		Locate            string `json:"locate"`
		Language          string `json:"language"`
		CreateTime        string `json:"create_time"`
		LastLoginTime     string `json:"last_login_time"`
	}
	GetUserInfoResp {
		BaseResponse
		Data UserInfoData `json:"data"`
	}
	UserContact {
		Id          string `json:"id"`
		Value       string `json:"value"`
		Type        int64  `json:"type"`
		PhoneRegion string `json:"phoneRegion"`
		Primary     bool   `json:"primary"`
	}
	ThirdPartyAccounts {
		Github bool `json:"github"`
		Google bool `json:"google"`
	}
	SecurityData {
		Contacts                []UserContact      `json:"contacts"`
		PasswordUpdatedDate     Birthday           `json:"passwordUpdatedDate"`
		AccountSecurityTokenNum int64              `json:"accountSecurityTokenNum"`
		PasskeysNum             int64              `json:"passkeysNum"`
		ThirdPartyAccounts      ThirdPartyAccounts `json:"thirdPartyAccounts"`
	}
	GetUserSecurityInfoResp {
		BaseResponse
		Data SecurityData `json:"data"`
	}
	RegStartReq {
		UserName    string `json:"user_name,optional"`
		DisplayName string `json:"display_name,optional"`
	}
	CeremonyData {
		OptionsJson string `json:"options_json"`
		SessionID   string `json:"session_id"`
	}
	CeremonyResp {
		BaseResponse
		Data CeremonyData `json:"data"`
	}
	RegFinishReq {
		SessionID  string `json:"session_id"`
		Credential string `json:"credential"`
		Language   string `json:"language"`
	}
	LoginFinishReq {
		SessionID string `json:"session_id"`
		Assertion string `json:"assertion"`
	}
	BindStartReq {
		Name string `json:"name"`
	}
	BindFinishReq {
		SessionID  string `json:"session_id"`
		Credential string `json:"credential"`
		Name       string `json:"name,optional"`
	}
	PasskeyData {
		Id   string   `json:"id"`
		Name string   `json:"name"`
		Date Birthday `json:"date"`
	}
	BindFinishResp {
		BaseResponse
		Data PasskeyData `json:"data"`
	}
	Passkey {
		Id        string   `json:"id"`
		Name      string   `json:"name"`
		Date      Birthday `json:"date"`
		IsEnabled bool     `json:"isEnabled"`
	}
	PasskeysData {
		Passkeys []Passkey `json:"passkeys"`
	}
	PasskeysResp {
		BaseResponse
		Data PasskeysData `json:"data"`
	}
	PageReq {
		Page int64 `json:"page"`
	}
	RemoveCredentialReq {
		Id string `json:"id"`
	}
	GenerateSubsystemTokenReq {
		// Scope items: 1=JQuantum, 2=Argus (reserved), 4=Hephaestus (reserved).
		// Omitted or blank names default to the first five uppercase UUID characters.
		Name  string  `json:"name,optional"`
		Scope []int64 `json:"scope"`
	}
	SubsystemToken {
		Id    string   `json:"id"`
		Value string   `json:"value"`
		Name  string   `json:"name"`
		Date  Birthday `json:"date"`
	}
	SubsystemTokenData {
		Token SubsystemToken `json:"token"`
	}
	SubsystemTokenResp {
		BaseResponse
		Data SubsystemTokenData `json:"data"`
	}
	SubsystemTokensData {
		Tokens []SubsystemToken `json:"tokens"`
	}
	SubsystemTokensResp {
		BaseResponse
		Data SubsystemTokensData `json:"data"`
	}
	ProviderReq {
		Provider string `json:"provider"`
	}
	AuthorizationData {
		Url string `json:"url"`
	}
	AuthorizationResp {
		BaseResponse
		Data AuthorizationData `json:"data"`
	}
	CallbackReq {
		Provider string `path:"provider"`
		State    string `form:"state"`
		Code     string `form:"code,optional"`
		Error    string `form:"error,optional"`
	}
	ThirdPartyAccount {
		Id       int64  `json:"id"`
		Provider string `json:"provider"`
		Content  string `json:"content"`
	}
	ThirdPartyData {
		Accounts []ThirdPartyAccount `json:"accounts"`
	}
	ThirdPartyResp {
		BaseResponse
		Data ThirdPartyData `json:"data"`
	}
	RemoveThirdPartyReq {
		ThirdPartyId int64 `json:"thirdPartyId"`
	}
	UpdateNameReq {
		GivenName  string `json:"given_name"`
		MiddleName string `json:"middle_name,optional"`
		FamilyName string `json:"family_name"`
	}
	UpdateBirthdayReq {
		Year  int64 `json:"year"`
		Month int64 `json:"month"`
		Day   int64 `json:"day"`
	}
	UpdateLanguageReq {
		Language string `json:"language"`
	}
	AddContactReq {
		Value       string `json:"value"`
		Type        int64  `json:"type"`
		PhoneRegion string `json:"phone_region,optional"`
	}
	ContactData {
		Contact UserContact `json:"contact"`
	}
	AddContactResp {
		BaseResponse
		Data ContactData `json:"data"`
	}
	RemoveContactReq {
		Id string `json:"id"`
	}
	ChangePasswordReq {
		CurrentPassword    string `json:"current_password"`
		NewPassword        string `json:"new_password"`
		ConfirmNewPassword string `json:"confirm_new_password"`
		SignOutEverywhere  bool   `json:"sign_out_everywhere,optional"`
	}
	ChangeNotificationEmailReq {
		Email string `json:"email"`
	}
	DeleteAccountReq {
		CurrentPassword string `json:"current_password,optional"`
		Confirmation    string `json:"confirmation"`
	}
)

@server (
	prefix:     /v1/account
	group:      account
	jwt:        Auth
	middleware: AccountAuthorization
)
service apollo-api {
	@handler GetUserInfo
	post /GetUserInfo (Empty) returns (GetUserInfoResp)

	@handler GetUserSecurityInfo
	post /GetUserSecurityInfo (Empty) returns (GetUserSecurityInfoResp)

	@handler VerifyToken
	post /VerifyToken (Empty) returns (OkResp)

	@handler UpdateName
	post /UpdateName (UpdateNameReq) returns (OkResp)

	@handler UpdateBirthday
	post /UpdateBirthday (UpdateBirthdayReq) returns (OkResp)

	@handler UpdateLanguage
	post /UpdateLanguage (UpdateLanguageReq) returns (OkResp)

	@handler AddContact
	post /AddContact (AddContactReq) returns (AddContactResp)

	@handler RemoveContact
	post /RemoveContact (RemoveContactReq) returns (OkResp)

	@handler ChangePassword
	post /ChangePassword (ChangePasswordReq) returns (OkResp)

	@handler ChangeNotificationEmail
	post /ChangeNotificationEmail (ChangeNotificationEmailReq) returns (OkResp)

	@handler RemoveNotificationEmail
	post /RemoveNotificationEmail (Empty) returns (OkResp)

	@handler DeleteAccount
	post /DeleteAccount (DeleteAccountReq) returns (OkResp)
}

@server (
	prefix: /v1/passkeys
	group:  passkeys
)
service apollo-api {
	@handler RegStart
	post /registration/start (RegStartReq) returns (CeremonyResp)

	@handler RegFinish
	post /registration/finish (RegFinishReq) returns (RegResp)

	@handler LoginStart
	post /login/start (Empty) returns (CeremonyResp)

	@handler LoginFinish
	post /login/finish (LoginFinishReq) returns (LoginResp)
}

@server (
	prefix:     /v1/passkeys
	group:      passkeys
	jwt:        Auth
	middleware: AccountAuthorization
)
service apollo-api {
	@handler BindStart
	post /bind/start (BindStartReq) returns (CeremonyResp)

	@handler BindFinish
	post /bind/finish (BindFinishReq) returns (BindFinishResp)
}

@server (
	prefix:     /v1/account/security
	group:      account/security
	jwt:        Auth
	middleware: AccountAuthorization
)
service apollo-api {
	@handler GenerateSubsystemToken
	post /GenerateSubsystemToken (GenerateSubsystemTokenReq) returns (SubsystemTokenResp)

	@handler GetTenSubsystemTokens
	post /GetTenSubsystemTokens (PageReq) returns (SubsystemTokensResp)

	@handler RemoveSubsystemToken
	post /RemoveSubsystemToken (RemoveCredentialReq) returns (OkResp)

	@handler GetTenPasskeys
	post /GetTenPasskeys (PageReq) returns (PasskeysResp)

	@handler RemovePasskey
	post /RemovePasskey (RemoveCredentialReq) returns (OkResp)
}

@server (
	prefix: /v1/thirdParty
	group:  thirdParty
)
service apollo-api {
	@handler Continue
	post /Continue (ProviderReq) returns (AuthorizationResp)

	@handler Callback
	get /Callback/:provider (CallbackReq) returns (RegResp)
}

@server (
	prefix:     /v1/thirdParty
	group:      thirdParty
	jwt:        Auth
	middleware: AccountAuthorization
)
service apollo-api {
	@handler Bind
	post /Bind (ProviderReq) returns (AuthorizationResp)

	@handler GetInfo
	post /GetInfo (Empty) returns (ThirdPartyResp)

	@handler Remove
	post /Remove (RemoveThirdPartyReq) returns (OkResp)
}

// Exact registered callbacks and S256 PKCE are mandatory.
type SSOAuthorizeReq {
	ClientId      string `json:"client_id"`
	RedirectUri   string `json:"redirect_uri"`
	CodeChallenge string `json:"code_challenge"`
}

type SSOCodeResp {
	Code string `json:"code"`
}

type SSOExchangeReq {
	ClientId     string `json:"client_id"`
	ClientSecret string `json:"client_secret"`
	Code         string `json:"code"`
	RedirectUri  string `json:"redirect_uri"`
	CodeVerifier string `json:"code_verifier"`
}

type SSOTokenReq {
	ClientId     string `json:"client_id"`
	ClientSecret string `json:"client_secret"`
	Token        string `json:"token"`
}

type SSOSessionResp {
	Token       string `json:"token,optional"`
	Subject     string `json:"subject"`
	DisplayName string `json:"display_name"`
	CsrfToken   string `json:"csrf_token"`
	ExpiresAt   string `json:"expires_at"`
	Scope       int64  `json:"scope"`
}

@server (
	prefix:     /v1/sso
	group:      sso
	jwt:        Auth
	middleware: AccountAuthorization
)
service apollo-api {
	@handler SSOLogout
	post /logout (Empty) returns (OkResp)

	@handler SSOAuthorize
	post /authorize (SSOAuthorizeReq) returns (SSOCodeResp)
}

@server (
	prefix: /v1/sso
	group:  sso
)
service apollo-api {
	@handler SSOExchange
	post /exchange (SSOExchangeReq) returns (SSOSessionResp)

	@handler SSOIntrospect
	post /introspect (SSOTokenReq) returns (SSOSessionResp)

	@handler SSORevoke
	post /revoke (SSOTokenReq) returns (OkResp)
}

